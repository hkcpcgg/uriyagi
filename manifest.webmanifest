{
  "name": "사랑흐름 우리 이야기",
  "short_name": "우리 이야기",
  "lang": "ko",
  "start_url": "/?app=1",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FFFCF7",
  "theme_color": "#1E4A76",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/?share=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*",
            ".jpg",
            ".jpeg",
            ".png",
            ".heic",
            ".webp"
          ]
        }
      ]
    }
  }
}
